<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_DoiTraTaiNha_20260821h" targetNamespace="http://hasaki.vn/bpmn/doi-tra-tai-nha-2026-08-21" exporter="Camunda Modeler" exporterVersion="5.49.0">
  <bpmn:collaboration id="Collab_DoiTraTaiNha">
    <bpmn:participant id="Pool_KhachHang" name="Khách hàng" processRef="Process_KhachHang" />
    <bpmn:participant id="Pool_Hasaki" name="Hasaki - Đổi trả tại nhà" processRef="Process_Hasaki" />
    <bpmn:participant id="Pool_VanChuyen" name="Đơn vị vận chuyển" />
    <bpmn:messageFlow id="MF_YeuCau" name="Yêu cầu đổi/trả" sourceRef="Task_KH_GuiYeuCau" targetRef="Start_Hasaki" />
    <bpmn:messageFlow id="MF_TuChoi" name="Không đủ điều kiện" sourceRef="Task_CSKH_ThongBaoTuChoi" targetRef="Catch_KH_TuChoi" />
    <bpmn:messageFlow id="MF_TuVan" name="Đề xuất phương án đã chốt" sourceRef="Task_CSKH_TuVan" targetRef="Catch_KH_TuVan" />
    <bpmn:messageFlow id="MF_Huy" name="Hủy yêu cầu" sourceRef="Task_KH_Huy" targetRef="Catch_HS_Huy" />
    <bpmn:messageFlow id="MF_TiepTuc" name="Xác nhận tiếp tục" sourceRef="Task_KH_XacNhanPA" targetRef="Catch_HS_TiepTuc" />
    <bpmn:messageFlow id="MF_Hang_BanGiao" name="Bàn giao hàng hoàn" sourceRef="Task_KH_GuiHang" targetRef="Pool_VanChuyen" />
    <bpmn:messageFlow id="MF_Hang_DenKho" name="Hàng đến kho" sourceRef="Pool_VanChuyen" targetRef="Catch_HS_HangVe" />
    <bpmn:messageFlow id="MF_Hang_ThayThe" name="Gửi sản phẩm thay thế" sourceRef="Task_Kho_GuiSP" targetRef="Pool_VanChuyen" />
    <bpmn:messageFlow id="MF_Hang_GiaoKH" name="Giao sản phẩm thay thế" sourceRef="Pool_VanChuyen" targetRef="Catch_KH_NhanHangThayThe" />
    <bpmn:messageFlow id="MF_KhongDat" name="Hàng hoàn không đạt — yêu cầu đổi trả bị hủy" sourceRef="Task_CSKH_ThongBaoKhongDat" targetRef="Catch_KH_KhongDat" />
    <bpmn:messageFlow id="MF_KetQua" name="Xác nhận hoàn tiền thành công" sourceRef="Task_CSKH_HoanTien" targetRef="Catch_KH_KetQua" />
  </bpmn:collaboration>
  <bpmn:process id="Process_KhachHang" name="Khách hàng" isExecutable="false">
    <bpmn:startEvent id="Start_KH" name="Cần đổi trả hoặc hoàn tiền" />
    <bpmn:task id="Task_KH_GuiYeuCau" name="Gửi yêu cầu đổi/trả" />
    <bpmn:eventBasedGateway id="Gw_KH_ChoPhanHoi" name="Chờ phản hồi từ Hasaki" />
    <bpmn:intermediateCatchEvent id="Catch_KH_TuChoi" name="Nhận thông báo từ chối">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_KH_TuChoi" name="Yêu cầu bị từ chối" />
    <bpmn:intermediateCatchEvent id="Catch_KH_TuVan" name="Nhận đề xuất phương án">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_KH_XacNhan" name="Xác nhận tiếp tục?" default="Flow_KH_TiepTuc" />
    <bpmn:endEvent id="End_KH_Huy" name="Khách hàng hủy yêu cầu" />
    <bpmn:task id="Task_KH_XacNhanPA" name="Xác nhận phương án" />
    <bpmn:task id="Task_KH_GuiHang" name="Gửi sản phẩm cần đổi trả" />
    <bpmn:eventBasedGateway id="Gw_KH_ChoKetQua" name="Chờ kết quả xử lý" />
    <bpmn:endEvent id="End_KH_Xong" name="Hoàn tiền thành công" />
    <bpmn:task id="Task_KH_Huy" name="Thông báo hủy yêu cầu" />
    <bpmn:sequenceFlow id="KH_01" sourceRef="Start_KH" targetRef="Task_KH_GuiYeuCau" />
    <bpmn:sequenceFlow id="KH_02" sourceRef="Task_KH_GuiYeuCau" targetRef="Gw_KH_ChoPhanHoi" />
    <bpmn:sequenceFlow id="KH_03a" sourceRef="Gw_KH_ChoPhanHoi" targetRef="Catch_KH_TuChoi" />
    <bpmn:sequenceFlow id="KH_03b" sourceRef="Gw_KH_ChoPhanHoi" targetRef="Catch_KH_TuVan" />
    <bpmn:sequenceFlow id="KH_04" sourceRef="Catch_KH_TuChoi" targetRef="End_KH_TuChoi" />
    <bpmn:sequenceFlow id="KH_05" sourceRef="Catch_KH_TuVan" targetRef="Gw_KH_XacNhan" />
    <bpmn:sequenceFlow id="Flow_KH_Huy" name="Hủy" sourceRef="Gw_KH_XacNhan" targetRef="Task_KH_Huy">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">xacNhanTiepTuc == false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_KH_TiepTuc" name="Tiếp tục" sourceRef="Gw_KH_XacNhan" targetRef="Task_KH_XacNhanPA" />
    <bpmn:sequenceFlow id="KH_06" sourceRef="Task_KH_Huy" targetRef="End_KH_Huy" />
    <bpmn:sequenceFlow id="KH_07" sourceRef="Task_KH_XacNhanPA" targetRef="Task_KH_GuiHang" />
    <bpmn:sequenceFlow id="KH_08" sourceRef="Task_KH_GuiHang" targetRef="Gw_KH_ChoKetQua" />
    <bpmn:sequenceFlow id="KH_09a" sourceRef="Gw_KH_ChoKetQua" targetRef="Catch_KH_KhongDat" />
    <bpmn:sequenceFlow id="KH_09b" sourceRef="Gw_KH_ChoKetQua" targetRef="Catch_KH_KetQua" />
    <bpmn:sequenceFlow id="KH_09c" sourceRef="Gw_KH_ChoKetQua" targetRef="Catch_KH_NhanHangThayThe" />
    <bpmn:sequenceFlow id="KH_11" sourceRef="Catch_KH_KetQua" targetRef="End_KH_Xong" />
    <bpmn:sequenceFlow id="KH_10" sourceRef="Catch_KH_KhongDat" targetRef="End_KH_KhongDat" />
    <bpmn:intermediateCatchEvent id="Catch_KH_KetQua" name="Tiền hoàn đã vào tài khoản">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_KH_KhongDat" name="Yêu cầu đổi trả bị hủy do hàng hoàn không đạt" />
    <bpmn:intermediateCatchEvent id="Catch_KH_KhongDat" name="Nhận thông báo hàng hoàn không đạt và yêu cầu bị hủy">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_KH_NhanHangThayThe" name="Đơn vị vận chuyển giao hàng thành công">
      <bpmn:outgoing>Flow_1mtxqh6</bpmn:outgoing>
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="Event_14aj32s" name="Đổi hàng thành công">
      <bpmn:incoming>Flow_1mtxqh6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1mtxqh6" sourceRef="Catch_KH_NhanHangThayThe" targetRef="Event_14aj32s" />
  </bpmn:process>
  <bpmn:process id="Process_Hasaki" name="Hasaki - Đổi trả tại nhà" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Hasaki">
      <bpmn:lane id="Lane_Kho" name="Kho vận">
        <bpmn:flowNodeRef>Task_Kho_TiepNhanHang</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Kho_KiemTraThucTe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_SPDat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Kho_GhiNhanDat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Kho_GuiSP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Throw_HS_KichHoatXuLyHang</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_HS_HangVe</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_CSKH" name="CSKH">
        <bpmn:flowNodeRef>Start_Hasaki</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CSKH_TiepNhan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CSKH_KiemTraDK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_DuDieuKien</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CSKH_ThongBaoTuChoi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CSKH_KiemTraTon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CSKH_TuVan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ChoXacNhan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CSKH_Huy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_HS_TuChoi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_HS_TiepTuc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_HS_Xong</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_ThucHienPA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CSKH_HoanTien</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_HS_Huy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CSKH_ThongBaoKhongDat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_HS_KhongDat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_HS_Huy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_JoinXuLy</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Hasaki" name="Nhận yêu cầu đổi trả">
      <bpmn:messageEventDefinition />
    </bpmn:startEvent>
    <bpmn:userTask id="Task_CSKH_TiepNhan" name="Tiếp nhận và xác minh yêu cầu" />
    <bpmn:userTask id="Task_CSKH_KiemTraDK" name="Kiểm tra điều kiện đổi trả" />
    <bpmn:exclusiveGateway id="Gw_DuDieuKien" name="Đủ điều kiện đổi trả?" default="Flow_KhongDu" />
    <bpmn:userTask id="Task_CSKH_ThongBaoTuChoi" name="Thông báo từ chối" />
    <bpmn:userTask id="Task_CSKH_KiemTraTon" name="Kiểm tra tồn kho" />
    <bpmn:userTask id="Task_CSKH_TuVan" name="Tư vấn và đề xuất phương án" />
    <bpmn:eventBasedGateway id="Gw_ChoXacNhan" name="Chờ xác nhận của khách" />
    <bpmn:userTask id="Task_CSKH_Huy" name="Ghi nhận hủy yêu cầu" />
    <bpmn:endEvent id="End_HS_TuChoi" name="Yêu cầu bị từ chối" />
    <bpmn:intermediateCatchEvent id="Catch_HS_TiepTuc" name="Nhận xác nhận phương án">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_HS_Xong" name="Đổi trả thành công" />
    <bpmn:exclusiveGateway id="Gw_ThucHienPA" name="Thực hiện theo phương án đã chốt?" default="Flow_ThucHienHoan" />
    <bpmn:userTask id="Task_CSKH_HoanTien" name="Thực hiện hoàn tiền theo chính sách" />
    <bpmn:intermediateCatchEvent id="Catch_HS_Huy" name="Nhận thông báo hủy">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_CSKH_ThongBaoKhongDat" name="Thông báo hàng hoàn không đạt và yêu cầu đổi trả bị hủy" />
    <bpmn:endEvent id="End_HS_KhongDat" name="Yêu cầu đổi trả bị hủy do hàng hoàn không đạt" />
    <bpmn:userTask id="Task_Kho_TiepNhanHang" name="Tiếp nhận hàng hoàn" />
    <bpmn:userTask id="Task_Kho_KiemTraThucTe" name="Kiểm tra sản phẩm thực tế" />
    <bpmn:exclusiveGateway id="Gw_SPDat" name="Sản phẩm đạt điều kiện?" default="Flow_SPKhongDat" />
    <bpmn:userTask id="Task_Kho_GhiNhanDat" name="Ghi nhận đã nhận hàng và kiểm thành công" />
    <bpmn:userTask id="Task_Kho_GuiSP" name="Gửi sản phẩm thay thế" />
    <bpmn:intermediateThrowEvent id="Throw_HS_KichHoatXuLyHang">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="HS_01" sourceRef="Start_Hasaki" targetRef="Task_CSKH_TiepNhan" />
    <bpmn:sequenceFlow id="HS_02" sourceRef="Task_CSKH_TiepNhan" targetRef="Task_CSKH_KiemTraDK" />
    <bpmn:sequenceFlow id="HS_03" sourceRef="Task_CSKH_KiemTraDK" targetRef="Gw_DuDieuKien" />
    <bpmn:sequenceFlow id="Flow_Du" name="Đủ điều kiện" sourceRef="Gw_DuDieuKien" targetRef="Task_CSKH_KiemTraTon">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">duDieuKien == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_KhongDu" name="Không đủ điều kiện" sourceRef="Gw_DuDieuKien" targetRef="Task_CSKH_ThongBaoTuChoi" />
    <bpmn:sequenceFlow id="HS_04" sourceRef="Task_CSKH_ThongBaoTuChoi" targetRef="End_HS_TuChoi" />
    <bpmn:sequenceFlow id="HS_05" sourceRef="Task_CSKH_KiemTraTon" targetRef="Task_CSKH_TuVan" />
    <bpmn:sequenceFlow id="HS_06" sourceRef="Task_CSKH_TuVan" targetRef="Gw_ChoXacNhan" />
    <bpmn:sequenceFlow id="HS_07a" sourceRef="Gw_ChoXacNhan" targetRef="Catch_HS_Huy" />
    <bpmn:sequenceFlow id="HS_07b" sourceRef="Gw_ChoXacNhan" targetRef="Catch_HS_TiepTuc" />
    <bpmn:sequenceFlow id="HS_08" sourceRef="Catch_HS_Huy" targetRef="Task_CSKH_Huy" />
    <bpmn:sequenceFlow id="HS_09" sourceRef="Task_CSKH_Huy" targetRef="End_HS_Huy" />
    <bpmn:sequenceFlow id="HS_10" sourceRef="Catch_HS_TiepTuc" targetRef="Catch_HS_HangVe" />
    <bpmn:sequenceFlow id="HS_17" sourceRef="Task_Kho_GuiSP" targetRef="Gw_JoinXuLy" />
    <bpmn:sequenceFlow id="HS_18" sourceRef="Task_CSKH_HoanTien" targetRef="Gw_JoinXuLy" />
    <bpmn:sequenceFlow id="HS_19" sourceRef="Gw_JoinXuLy" targetRef="End_HS_Xong" />
    <bpmn:sequenceFlow id="HS_16" sourceRef="Task_Kho_GhiNhanDat" targetRef="Gw_ThucHienPA" />
    <bpmn:sequenceFlow id="Flow_ThucHienDoi" name="Đổi hàng" sourceRef="Gw_ThucHienPA" targetRef="Task_Kho_GuiSP">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">phuongAn == "doi_hang"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ThucHienHoan" name="Hoàn tiền" sourceRef="Gw_ThucHienPA" targetRef="Task_CSKH_HoanTien" />
    <bpmn:sequenceFlow id="HS_14" sourceRef="Throw_HS_KichHoatXuLyHang" targetRef="Task_CSKH_ThongBaoKhongDat" />
    <bpmn:sequenceFlow id="HS_15" sourceRef="Task_CSKH_ThongBaoKhongDat" targetRef="End_HS_KhongDat" />
    <bpmn:sequenceFlow id="HS_11" sourceRef="Catch_HS_HangVe" targetRef="Task_Kho_TiepNhanHang" />
    <bpmn:sequenceFlow id="HS_12" sourceRef="Task_Kho_TiepNhanHang" targetRef="Task_Kho_KiemTraThucTe" />
    <bpmn:sequenceFlow id="HS_13" sourceRef="Task_Kho_KiemTraThucTe" targetRef="Gw_SPDat" />
    <bpmn:sequenceFlow id="Flow_SPDat" name="Đạt" sourceRef="Gw_SPDat" targetRef="Task_Kho_GhiNhanDat">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">sanPhamDat == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SPKhongDat" name="Không đạt" sourceRef="Gw_SPDat" targetRef="Throw_HS_KichHoatXuLyHang" />
    <bpmn:intermediateCatchEvent id="Catch_HS_HangVe" name="Nhận hàng gửi về">
      <bpmn:messageEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_HS_Huy" name="Khách hàng hủy yêu cầu" />
    <bpmn:exclusiveGateway id="Gw_JoinXuLy" name="Đã xử lý đổi hoặc hoàn" />
    <bpmn:textAnnotation id="Ann_KichHoatXuLyHang">
      <bpmn:text>Kích hoạt QT xử lý hàng hoàn không đạt</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_KichHoatXuLyHang" sourceRef="Throw_HS_KichHoatXuLyHang" targetRef="Ann_KichHoatXuLyHang" />
  </bpmn:process>

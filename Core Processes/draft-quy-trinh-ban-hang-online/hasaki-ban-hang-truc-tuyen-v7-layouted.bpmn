<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_HasakiOnline_v7" targetNamespace="http://hasaki.vn/bpmn/fbpm">
  <bpmn:collaboration id="Collaboration_HasakiOnline_v7" name="Bán hàng trực tuyến Hasaki (v7)">
    <bpmn:participant id="Pool_Customer" name="Khách hàng" processRef="Process_Customer" />
    <bpmn:participant id="Pool_Hasaki" name="Hasaki" processRef="Process_Hasaki" />
    <bpmn:messageFlow id="Msg_Order" name="Yêu cầu đặt hàng" sourceRef="Task_PlaceOrder" targetRef="Start_Hasaki" />
    <bpmn:messageFlow id="Msg_InStock" name="Còn hàng — tiếp tục" sourceRef="Gw_Stock" targetRef="Catch_InStock" />
    <bpmn:messageFlow id="Msg_OOS" name="Thông báo hết hàng" sourceRef="Task_NotifyOOS" targetRef="Catch_OOS" />
    <bpmn:messageFlow id="Msg_PayChoice" name="Lựa chọn thanh toán" sourceRef="Task_ChoosePay" targetRef="Catch_PayChoice" />
    <bpmn:messageFlow id="Msg_Confirmed" name="Xác nhận đơn hàng" sourceRef="Task_ConfirmOrder" targetRef="Catch_Confirmed" />
    <bpmn:messageFlow id="Msg_PayFail" name="Thanh toán thất bại / hủy" sourceRef="End_Cancel" targetRef="Catch_Cancel" />
    <bpmn:messageFlow id="Msg_Delivered" name="Giao hàng" sourceRef="Task_Deliver" targetRef="Catch_Receive" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Customer" name="Mua hàng online" isExecutable="false">
    <bpmn:startEvent id="Start_Customer" name="Bắt đầu mua sắm">
      <bpmn:outgoing>Flow_C1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_PlaceOrder" name="Chọn sản phẩm và gửi yêu cầu đặt hàng">
      <bpmn:incoming>Flow_C1</bpmn:incoming>
      <bpmn:outgoing>Flow_C2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:eventBasedGateway id="Gw_WaitStock" name="Chờ kết quả tồn kho">
      <bpmn:incoming>Flow_C2</bpmn:incoming>
      <bpmn:outgoing>Flow_C_WaitOk</bpmn:outgoing>
      <bpmn:outgoing>Flow_C_WaitOOS</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Catch_InStock" name="Nhận thông báo còn hàng">
      <bpmn:incoming>Flow_C_WaitOk</bpmn:incoming>
      <bpmn:outgoing>Flow_C3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_InStock" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_OOS" name="Nhận thông báo hết hàng">
      <bpmn:incoming>Flow_C_WaitOOS</bpmn:incoming>
      <bpmn:outgoing>Flow_C4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_OOS" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_HandleOOS" name="Chọn sản phẩm khác hoặc dừng">
      <bpmn:incoming>Flow_C4</bpmn:incoming>
      <bpmn:outgoing>Flow_C5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_CustOOS" name="Kết thúc do hết hàng">
      <bpmn:incoming>Flow_C5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_ChoosePay" name="Chọn phương thức thanh toán">
      <bpmn:incoming>Flow_C3</bpmn:incoming>
      <bpmn:outgoing>Flow_C6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DoPay" name="Thanh toán online hoặc xác nhận COD">
      <bpmn:incoming>Flow_C6</bpmn:incoming>
      <bpmn:outgoing>Flow_C7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:eventBasedGateway id="Gw_WaitConfirm" name="Chờ xác nhận hoặc hủy">
      <bpmn:incoming>Flow_C7</bpmn:incoming>
      <bpmn:outgoing>Flow_C_WaitConf</bpmn:outgoing>
      <bpmn:outgoing>Flow_C_WaitCancel</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Catch_Confirmed" name="Nhận xác nhận đơn hàng">
      <bpmn:incoming>Flow_C_WaitConf</bpmn:incoming>
      <bpmn:outgoing>Flow_C8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Confirmed" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_Cancel" name="Nhận thông báo hủy đơn">
      <bpmn:incoming>Flow_C_WaitCancel</bpmn:incoming>
      <bpmn:outgoing>Flow_C_ToCancel</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Cancel" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Catch_Receive" name="Chờ nhận hàng">
      <bpmn:incoming>Flow_C8</bpmn:incoming>
      <bpmn:outgoing>Flow_C9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Receive" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="Task_Receive" name="Nhận hàng">
      <bpmn:incoming>Flow_C9</bpmn:incoming>
      <bpmn:outgoing>Flow_C10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_Return" name="Yêu cầu đổi hoặc trả hàng?" default="Flow_Cust_NoReturn">
      <bpmn:incoming>Flow_C10</bpmn:incoming>
      <bpmn:outgoing>Flow_Cust_WantReturn</bpmn:outgoing>
      <bpmn:outgoing>Flow_Cust_NoReturn</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_CustSuccess" name="Hoàn thành">
      <bpmn:incoming>Flow_Cust_NoReturn</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_CustCancel" name="Hủy đơn hàng">
      <bpmn:incoming>Flow_C_ToCancel</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_CustReturn" name="Chuyển quy trình đổi trả">
      <bpmn:incoming>Flow_Cust_WantReturn</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_C1" sourceRef="Start_Customer" targetRef="Task_PlaceOrder" />
    <bpmn:sequenceFlow id="Flow_C2" sourceRef="Task_PlaceOrder" targetRef="Gw_WaitStock" />
    <bpmn:sequenceFlow id="Flow_C_WaitOk" sourceRef="Gw_WaitStock" targetRef="Catch_InStock" />
    <bpmn:sequenceFlow id="Flow_C_WaitOOS" sourceRef="Gw_WaitStock" targetRef="Catch_OOS" />
    <bpmn:sequenceFlow id="Flow_C3" sourceRef="Catch_InStock" targetRef="Task_ChoosePay" />
    <bpmn:sequenceFlow id="Flow_C4" sourceRef="Catch_OOS" targetRef="Task_HandleOOS" />
    <bpmn:sequenceFlow id="Flow_C5" sourceRef="Task_HandleOOS" targetRef="End_CustOOS" />
    <bpmn:sequenceFlow id="Flow_C6" sourceRef="Task_ChoosePay" targetRef="Task_DoPay" />
    <bpmn:sequenceFlow id="Flow_C7" sourceRef="Task_DoPay" targetRef="Gw_WaitConfirm" />
    <bpmn:sequenceFlow id="Flow_C_WaitConf" sourceRef="Gw_WaitConfirm" targetRef="Catch_Confirmed" />
    <bpmn:sequenceFlow id="Flow_C_WaitCancel" sourceRef="Gw_WaitConfirm" targetRef="Catch_Cancel" />
    <bpmn:sequenceFlow id="Flow_C_ToCancel" sourceRef="Catch_Cancel" targetRef="End_CustCancel" />
    <bpmn:sequenceFlow id="Flow_C8" sourceRef="Catch_Confirmed" targetRef="Catch_Receive" />
    <bpmn:sequenceFlow id="Flow_C9" sourceRef="Catch_Receive" targetRef="Task_Receive" />
    <bpmn:sequenceFlow id="Flow_C10" sourceRef="Task_Receive" targetRef="Gw_Return" />
    <bpmn:sequenceFlow id="Flow_Cust_WantReturn" name="Có" sourceRef="Gw_Return" targetRef="End_CustReturn">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${requestReturn == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Cust_NoReturn" name="Không" sourceRef="Gw_Return" targetRef="End_CustSuccess" />
  </bpmn:process>
  <bpmn:process id="Process_Hasaki" name="Xử lý đơn hàng online" isExecutable="false">
    <bpmn:startEvent id="Start_Hasaki" name="Tiếp nhận yêu cầu đặt hàng">
      <bpmn:outgoing>Flow_H1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Start" />
    </bpmn:startEvent>
    <bpmn:task id="Task_CheckStock" name="Kiểm tra tồn kho">
      <bpmn:incoming>Flow_H1</bpmn:incoming>
      <bpmn:outgoing>Flow_H2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_Stock" name="Sản phẩm còn hàng?" default="Flow_H_OOS">
      <bpmn:incoming>Flow_H2</bpmn:incoming>
      <bpmn:outgoing>Flow_H_InStock</bpmn:outgoing>
      <bpmn:outgoing>Flow_H_OOS</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_NotifyOOS" name="Thông báo hết hàng">
      <bpmn:incoming>Flow_H_OOS</bpmn:incoming>
      <bpmn:outgoing>Flow_H3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_HasakiOOS" name="Hủy do hết hàng">
      <bpmn:incoming>Flow_H3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Catch_PayChoice" name="Nhận lựa chọn thanh toán">
      <bpmn:incoming>Flow_H_InStock</bpmn:incoming>
      <bpmn:outgoing>Flow_H4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_PayChoice" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_PayType" name="Thanh toán trực tuyến?" default="Flow_H_COD">
      <bpmn:incoming>Flow_H4</bpmn:incoming>
      <bpmn:outgoing>Flow_H_Online</bpmn:outgoing>
      <bpmn:outgoing>Flow_H_COD</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ProcessPay" name="Xử lý thanh toán">
      <bpmn:incoming>Flow_H_Online</bpmn:incoming>
      <bpmn:outgoing>Flow_H5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Catch_PayResult" name="Nhận kết quả thanh toán">
      <bpmn:incoming>Flow_H5</bpmn:incoming>
      <bpmn:outgoing>Flow_H6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Pay" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_Payment" name="Thanh toán thành công?" default="Flow_H_PayOk">
      <bpmn:incoming>Flow_H6</bpmn:incoming>
      <bpmn:outgoing>Flow_H_PayFail</bpmn:outgoing>
      <bpmn:outgoing>Flow_H_PayOk</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_JoinCreate" name="Vào xác nhận đơn">
      <bpmn:incoming>Flow_H_COD</bpmn:incoming>
      <bpmn:incoming>Flow_H_PayOk</bpmn:incoming>
      <bpmn:outgoing>Flow_H_ToCreate</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CreateOrder" name="Xác nhận đơn hàng">
      <bpmn:incoming>Flow_H_ToCreate</bpmn:incoming>
      <bpmn:outgoing>Flow_H7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="And_Fork" name="Song song: chuẩn bị hàng và cập nhật đơn">
      <bpmn:incoming>Flow_H7</bpmn:incoming>
      <bpmn:outgoing>Flow_H_AndPrep</bpmn:outgoing>
      <bpmn:outgoing>Flow_H_AndConf</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_Prepare" name="Chuẩn bị hàng hóa">
      <bpmn:incoming>Flow_H_AndPrep</bpmn:incoming>
      <bpmn:outgoing>Flow_H_PrepDone</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ConfirmOrder" name="Cập nhật và xác nhận đơn hàng">
      <bpmn:incoming>Flow_H_AndConf</bpmn:incoming>
      <bpmn:outgoing>Flow_H_ConfDone</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="And_Join" name="Đồng bộ hai nhánh">
      <bpmn:incoming>Flow_H_PrepDone</bpmn:incoming>
      <bpmn:incoming>Flow_H_ConfDone</bpmn:incoming>
      <bpmn:outgoing>Flow_H8</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_Deliver" name="Giao hàng cho khách">
      <bpmn:incoming>Flow_H8</bpmn:incoming>
      <bpmn:outgoing>Flow_H9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="Catch_Delivery" name="Nhận kết quả giao hàng">
      <bpmn:incoming>Flow_H9</bpmn:incoming>
      <bpmn:outgoing>Flow_H10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_Del" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gw_Delivery" name="Giao hàng thành công?" default="Flow_H_DelOk">
      <bpmn:incoming>Flow_H10</bpmn:incoming>
      <bpmn:outgoing>Flow_H_DelOk</bpmn:outgoing>
      <bpmn:outgoing>Flow_H_DelFail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_HandleDelFail" name="Xử lý giao lại hoặc hủy đơn">
      <bpmn:incoming>Flow_H_DelFail</bpmn:incoming>
      <bpmn:outgoing>Flow_H11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_JoinCancel" name="Vào hủy đơn">
      <bpmn:incoming>Flow_H_PayFail</bpmn:incoming>
      <bpmn:incoming>Flow_H11</bpmn:incoming>
      <bpmn:outgoing>Flow_H_ToCancel</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Success" name="Hoàn thành">
      <bpmn:incoming>Flow_H_DelOk</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Cancel" name="Hủy đơn hàng">
      <bpmn:incoming>Flow_H_ToCancel</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_H1" sourceRef="Start_Hasaki" targetRef="Task_CheckStock" />
    <bpmn:sequenceFlow id="Flow_H2" sourceRef="Task_CheckStock" targetRef="Gw_Stock" />
    <bpmn:sequenceFlow id="Flow_H_InStock" name="Có" sourceRef="Gw_Stock" targetRef="Catch_PayChoice">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${inStock == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_H_OOS" name="Không" sourceRef="Gw_Stock" targetRef="Task_NotifyOOS" />
    <bpmn:sequenceFlow id="Flow_H3" sourceRef="Task_NotifyOOS" targetRef="End_HasakiOOS" />
    <bpmn:sequenceFlow id="Flow_H4" sourceRef="Catch_PayChoice" targetRef="Gw_PayType" />
    <bpmn:sequenceFlow id="Flow_H_Online" name="Có" sourceRef="Gw_PayType" targetRef="Task_ProcessPay">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${paymentMethod == "ONLINE"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_H_COD" name="Không (COD)" sourceRef="Gw_PayType" targetRef="Gw_JoinCreate" />
    <bpmn:sequenceFlow id="Flow_H5" sourceRef="Task_ProcessPay" targetRef="Catch_PayResult" />
    <bpmn:sequenceFlow id="Flow_H6" sourceRef="Catch_PayResult" targetRef="Gw_Payment" />
    <bpmn:sequenceFlow id="Flow_H_PayFail" name="Không" sourceRef="Gw_Payment" targetRef="Gw_JoinCancel">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${paymentSuccessful == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_H_PayOk" name="Có" sourceRef="Gw_Payment" targetRef="Gw_JoinCreate" />
    <bpmn:sequenceFlow id="Flow_H_ToCreate" sourceRef="Gw_JoinCreate" targetRef="Task_CreateOrder" />
    <bpmn:sequenceFlow id="Flow_H7" sourceRef="Task_CreateOrder" targetRef="And_Fork" />
    <bpmn:sequenceFlow id="Flow_H_AndPrep" sourceRef="And_Fork" targetRef="Task_Prepare" />
    <bpmn:sequenceFlow id="Flow_H_AndConf" sourceRef="And_Fork" targetRef="Task_ConfirmOrder" />
    <bpmn:sequenceFlow id="Flow_H_PrepDone" sourceRef="Task_Prepare" targetRef="And_Join" />
    <bpmn:sequenceFlow id="Flow_H_ConfDone" sourceRef="Task_ConfirmOrder" targetRef="And_Join" />
    <bpmn:sequenceFlow id="Flow_H8" sourceRef="And_Join" targetRef="Task_Deliver" />
    <bpmn:sequenceFlow id="Flow_H9" sourceRef="Task_Deliver" targetRef="Catch_Delivery" />
    <bpmn:sequenceFlow id="Flow_H10" sourceRef="Catch_Delivery" targetRef="Gw_Delivery" />
    <bpmn:sequenceFlow id="Flow_H_DelOk" name="Có" sourceRef="Gw_Delivery" targetRef="End_Success" />
    <bpmn:sequenceFlow id="Flow_H_DelFail" name="Không" sourceRef="Gw_Delivery" targetRef="Task_HandleDelFail">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${deliverySuccessful == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_H11" sourceRef="Task_HandleDelFail" targetRef="Gw_JoinCancel" />
    <bpmn:sequenceFlow id="Flow_H_ToCancel" sourceRef="Gw_JoinCancel" targetRef="End_Cancel" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Collaboration_HasakiOnline_v7">
    <bpmndi:BPMNPlane id="BPMNPlane_Collaboration_HasakiOnline_v7" bpmnElement="Collaboration_HasakiOnline_v7">
      <bpmndi:BPMNShape id="BPMNShape_Pool_Customer" bpmnElement="Pool_Customer" isHorizontal="true">
        <dc:Bounds x="112" y="80" width="1940" height="320" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Pool_Hasaki" bpmnElement="Pool_Hasaki" isHorizontal="true">
        <dc:Bounds x="80" y="480" width="3154" height="640" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Msg_Order" bpmnElement="Msg_Order">
        <di:waypoint x="368" y="200" />
        <di:waypoint x="368" y="440" />
        <di:waypoint x="168" y="440" />
        <di:waypoint x="168" y="542" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="230" y="407" width="77" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Msg_InStock" bpmnElement="Msg_InStock">
        <di:waypoint x="511" y="535" />
        <di:waypoint x="511" y="440" />
        <di:waypoint x="648" y="440" />
        <di:waypoint x="648" y="178" />
        <di:waypoint x="648" y="160" />
        <di:waypoint x="668" y="160" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="573" y="275" width="70" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Msg_OOS" bpmnElement="Msg_OOS">
        <di:waypoint x="686" y="520" />
        <di:waypoint x="686" y="338" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="691" y="355" width="66" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Msg_PayChoice" bpmnElement="Msg_PayChoice">
        <di:waypoint x="824" y="200" />
        <di:waypoint x="824" y="220" />
        <di:waypoint x="784" y="220" />
        <di:waypoint x="784" y="440" />
        <di:waypoint x="756" y="440" />
        <di:waypoint x="756" y="702" />
        <di:waypoint x="724" y="702" />
        <di:waypoint x="724" y="720" />
        <di:waypoint x="704" y="720" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="761" y="517" width="71" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Msg_Confirmed" bpmnElement="Msg_Confirmed">
        <di:waypoint x="1992" y="1000" />
        <di:waypoint x="1992" y="980" />
        <di:waypoint x="1952" y="980" />
        <di:waypoint x="1952" y="440" />
        <di:waypoint x="1334" y="440" />
        <di:waypoint x="1334" y="178" />
        <di:waypoint x="1334" y="160" />
        <di:waypoint x="1354" y="160" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1311" y="445" width="84" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Msg_PayFail" bpmnElement="Msg_PayFail">
        <di:waypoint x="3176" y="862" />
        <di:waypoint x="3176" y="440" />
        <di:waypoint x="1372" y="440" />
        <di:waypoint x="1372" y="338" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2738" y="393" width="73" height="42" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Msg_Delivered" bpmnElement="Msg_Delivered">
        <di:waypoint x="2372" y="680" />
        <di:waypoint x="2372" y="440" />
